# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM + embeddings via DeepInfra (OpenAI-compatible). OPENAI_API_KEY is an optional fallback.
DEEPINFRA_API_KEY=
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=uttarakhand-planner
PINECONE_VECTOR_DIM=1024

NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

REDIS_HOST=localhost
REDIS_PORT=6379
RATE_LIMIT_PER_MINUTE=10

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage. Leave empty to use local SQLite files (data/*.sqlite). For a deploy, use Postgres,
# e.g. a free Neon database: postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=

# Long-term agent memory (preferences and past trips). Stored in DATABASE_URL when set.
MEMORY_ENABLED=true
MEMORY_PATH=data/memory.sqlite

# Guest mode: try the app without an account (stricter limits, 24 h tokens)
GUEST_ENABLED=true
GUEST_RATE_LIMIT_PER_MINUTE=10
GUEST_SESSIONS_PER_IP_PER_HOUR=10
GUEST_SESSIONS_PER_DAY=300

# Google Places: hotel ratings and reviews in the Concierge stage, and `ingest.build --google`.
# Billable: set a budget cap in Google Cloud. PLACES_DAILY_CAP limits calls per process per day.
GOOGLE_PLACES_API_KEY=
PLACES_DAILY_CAP=300

# Optional web search (Tavily, free tier) for live travel notes in the Concierge stage.
TAVILY_API_KEY=
SEARCH_DAILY_CAP=200
CONCIERGE_ENABLED=true

# Optional tracing of every LLM call to Langfuse (needs `pip install langfuse`).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Cost estimates: USD to INR, and per-model prices as JSON {"model": [in, out]} per 1M tokens
USD_TO_INR=88
MODEL_PRICES=
