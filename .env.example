# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM + embeddings via DeepInfra (OpenAI-compatible). OPENAI_API_KEY is an optional fallback.
DEEPINFRA_API_KEY=
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=uttarakhand-planner
PINECONE_VECTOR_DIM=1024

NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

REDIS_HOST=localhost
REDIS_PORT=6379
RATE_LIMIT_PER_MINUTE=10

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional, for `python -m ingest.build --google` (billable; set a budget cap in Google Cloud)
GOOGLE_PLACES_API_KEY=
